# 运行环境：dev / prod（prod 下会强制校验 JWT/微信配置，禁止 Mock 登录）
ENV=dev

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=eventflow
MYSQL_USER=eventflow
MYSQL_PASSWORD=change_me

# WeChat 小程序
WECHAT_APP_ID=your_appid
WECHAT_APP_SECRET=your_appsecret

# JWT
JWT_SECRET=please_change_this_to_a_long_random_string

# 本地测试用：填入后跳过真实微信 code2Session，直接使用该 openid
# 生产环境（ENV=prod）禁止设置此项
WECHAT_MOCK_OPENID=
