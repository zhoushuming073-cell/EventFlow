# 统一行尾：文本文件用 LF，避免 Windows/Linux 混用导致 Docker 构建问题
* text=auto

# 以下文件强制 LF（对 Linux/Docker 部署至关重要）
*.py text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.toml text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
