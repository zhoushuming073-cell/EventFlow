.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 16rpx 0 24rpx;
}

.empty {
  text-align: center;
  color: #999999;
  padding: 80rpx 0;
}

.space-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.space-name {
  font-size: 32rpx;
  font-weight: 600;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  width: 620rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
}

.name-input {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.template-item {
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx;
}

.template-item.active {
  border-color: #07c160;
  background: #f0faf4;
}

.template-label {
  font-weight: 600;
}

.template-desc {
  font-size: 24rpx;
  color: #999999;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.cancel-btn {
  flex: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.confirm-btn {
  flex: 1;
}
