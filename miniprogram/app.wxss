page {
  --primary: #07c160;
  --danger: #fa5151;
  background: #f5f6f8;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card-panel {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
}

.text-muted {
  color: #999999;
  font-size: 24rpx;
}
